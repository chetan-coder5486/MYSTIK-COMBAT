[gd_scene format=3 uid="uid://cjmtc3orrycsw"]

[ext_resource type="Texture2D" uid="uid://cmbqd5yogwtf7" path="res://assets/ui/character_select_bg.png" id="2_ejo3v"]
[ext_resource type="Texture2D" uid="uid://cc8p2wd46qmr7" path="res://assets/characters/kaal/kaal_portrait.png" id="2_ppjiv"]
[ext_resource type="Texture2D" uid="uid://b38rgix4d8bum" path="res://assets/characters/nex/nex_portrait.png" id="3_ejo3v"]

[sub_resource type="GDScript" id="GDScript_ppjiv"]
script/source = "
extends Control

var player1_choice: String = \"KAAL\"
var player2_choice: String = \"NEX\"

@onready var p1_kaal: Button = $Roster/P1RosterRow/P1KaalCard/P1KaalButton
@onready var p1_nex: Button = $Roster/P1RosterRow/P1NexCard/P1NexButton

@onready var p2_kaal: Button = $Roster/P2RosterRow/P2KaalCard/P2KaalButton
@onready var p2_nex: Button = $Roster/P2RosterRow/P2NexCard/P2NexButton

@onready var fight_button: Button = $Content/FightButton
@onready var back_button: Button = $Content/BackButton

@onready var p1_portrait: TextureRect = $Player1Display/CharacterPortrait
@onready var p1_name: Label = $Player1Display/CharacterName

@onready var p2_portrait: TextureRect = $Player2Display/CharacterPortrait
@onready var p2_name: Label = $Player2Display/CharacterName

const KAAL_PORTRAIT: Texture2D = preload(
	\"res://assets/characters/kaal/kaal_portrait.png\"
)

const NEX_PORTRAIT: Texture2D = preload(
	\"res://assets/characters/nex/nex_portrait.png\"
)


func _ready() -> void:
	print(\"P1 KAAL button: \", p1_kaal)
	print(\"P1 NEX button: \", p1_nex)
	print(\"P2 KAAL button: \", p2_kaal)
	print(\"P2 NEX button: \", p2_nex)
	print(\"Fight button: \", fight_button)
	print(\"Back button: \", back_button)
	p1_kaal.pressed.connect(_on_p1_kaal_pressed)
	p1_nex.pressed.connect(_on_p1_nex_pressed)
	p2_kaal.pressed.connect(_on_p2_kaal_pressed)
	p2_nex.pressed.connect(_on_p2_nex_pressed)

	fight_button.pressed.connect(_on_fight_pressed)
	back_button.pressed.connect(_on_back_pressed)
	update_selection_display()


func _on_p1_kaal_pressed() -> void:
	player1_choice = \"KAAL\"
	update_selection_display()


func _on_p1_nex_pressed() -> void:
	player1_choice = \"NEX\"
	update_selection_display()


func _on_p2_kaal_pressed() -> void:
	player2_choice = \"KAAL\"
	update_selection_display()


func _on_p2_nex_pressed() -> void:
	player2_choice = \"NEX\"
	update_selection_display()



func update_selection_display() -> void:
	p1_kaal.text = \"KAAL  ✓\" if player1_choice == \"KAAL\" else \"KAAL\"
	p1_nex.text = \"NEX  ✓\" if player1_choice == \"NEX\" else \"NEX\"

	p2_kaal.text = \"KAAL  ✓\" if player2_choice == \"KAAL\" else \"KAAL\"
	p2_nex.text = \"NEX  ✓\" if player2_choice == \"NEX\" else \"NEX\"

	update_large_portraits()
	print(\"Player 1 selected: \", player1_choice)
	print(\"Player 2 selected: \", player2_choice)



func _on_fight_pressed() -> void:
	GameSettings.player1_character = player1_choice
	GameSettings.player2_character = player2_choice
	get_tree().change_scene_to_file(\"res://Main.tscn\")


func _on_back_pressed() -> void:
	get_tree().change_scene_to_file(\"res://MainMenu.tscn\")


func update_large_portraits() -> void:
	p1_portrait.texture = KAAL_PORTRAIT if player1_choice == \"KAAL\" else NEX_PORTRAIT
	p1_name.text = player1_choice

	p2_portrait.texture = KAAL_PORTRAIT if player2_choice == \"KAAL\" else NEX_PORTRAIT
	p2_name.text = player2_choice
"

